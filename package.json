{
  "name": "@automatron/underwrite",
  "version": "0.2.0",
  "description": "An inline sponsored credit component for LLM chat. Watch a short sponsor card, earn model credits, inspect the single use receipt.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://automatron-workflows.github.io/underwrite/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automatron-workflows/underwrite.git"
  },
  "bugs": {
    "url": "https://github.com/Automatron-workflows/underwrite/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "underwrite": "./bin/underwrite.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./protocol": "./src/protocol.mjs",
    "./issuer": "./src/issuer.mjs",
    "./element": "./src/element.mjs"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "docs",
    "assets",
    "index.html",
    "styles.css",
    "app.mjs",
    "hosts.html",
    "hosts.css",
    "hosts.mjs",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "MAINTAINING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/build-site.mjs && node scripts/browser-check.mjs",
    "check": "npm test && node scripts/check.mjs",
    "dev": "node scripts/serve.mjs",
    "verify": "node bin/underwrite.mjs verify",
    "credit": "node bin/underwrite.mjs credit",
    "demo": "node bin/underwrite.mjs demo",
    "build:site": "node scripts/build-site.mjs"
  },
  "keywords": [
    "ads",
    "credits",
    "llm",
    "custom-element",
    "attention",
    "sponsored-inference",
    "underwriting",
    "sponsored-access"
  ],
  "devDependencies": {
    "playwright-core": "1.65.1"
  }
}
